        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The commission concludes that the coastal survey achieved the greater part of its stated objectives. Positions were fixed for eleven of the fourteen proposed stations, and tidal series of at least six months were obtained at seven."
                    }
                ]
            },
            "bbox": [
                111,
                135,
                733,
                196
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The loss of the third party's notebooks is regretted. The commission recommends that duplicate records be transmitted by post at fortnightly intervals in all future work of this character, and that no single vessel carry the whole of a season's observations."
                    }
                ]
            },
            "bbox": [
                111,
                219,
                756,
                304
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The commission further records its appreciation of the resident observers, whose diligence under conditions of considerable hardship is evident throughout the returns."
                    }
                ]
            },
