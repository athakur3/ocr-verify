[
    [
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Observations of the Tide"
                    }
                ],
                "level": 2
            },
            "bbox": [
                112,
                92,
                313,
                109
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "Tidal observations at Station Marlow were continued through the winter without interruption. The gauge was of the float pattern, housed in a timber well sunk four feet below the lowest recorded water. Readings were taken hourly by the resident observer and transcribed each evening."
                    }
                ]
            },
            "bbox": [
                111,
                135,
                751,
                219
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The self-registering apparatus failed twice during December, on both occasions owing to the freezing of the float chamber. Manual readings were substituted for the affected intervals and are marked accordingly in the published tables."
                    }
                ]
            },
            "bbox": [
                111,
                241,
                743,
                304
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "A comparison of the winter series with the corresponding series from the preceding year shows agreement within two hundredths of a foot for the mean water level, which the commission regarded as satisfactory."
                    }
                ]
            },
            "bbox": [
                111,
                325,
                733,
                388
            ]
        }
    ],
